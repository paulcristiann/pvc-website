---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import { profile } from '../data/portfolio';
import { pendingClaims } from '../data/confirm';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

// Never publish unconfirmed claims. Preview locally with ALLOW_UNCONFIRMED=1.
if (import.meta.env.PROD && pendingClaims.length && process.env.ALLOW_UNCONFIRMED !== '1') {
  throw new Error(
    `Unconfirmed claims would go live. Confirm or remove them in src/data/confirm.ts:\n` +
      pendingClaims.map((c) => `  - ${c.key}: ${c.note}`).join('\n'),
  );
}

const home = Astro.url.pathname === '/' ? '' : '/';
const nav = [
  { label: 'Work', href: `${home}#work` },
  { label: 'How I work', href: `${home}#workflow` },
  { label: 'Experience', href: `${home}#experience` },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.role,
        email: `mailto:${profile.email}`,
        url: Astro.site?.toString(),
        sameAs: profile.socials.map((s) => s.href),
      })}
    />
  </head>
  <body>
    {
      pendingClaims.length > 0 && (
        <div class="preview-banner mono" role="note">
          Preview · {pendingClaims.length} claims marked <span class="tbc-sample">like this</span> await
          confirmation
        </div>
      )
    }
    <header class="nav">
      <div class="nav-inner container">
        <a class="nav-brand" href="/">{profile.name}</a>
        <nav class="nav-links" aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="nav-actions">
          <button class="nav-k" type="button" data-cmdk-open aria-label="Open command menu">
            <span class="nav-k-label">Search</span>
            <kbd>⌘K</kbd>
          </button>
          <a class="nav-cta" href={`${home}#contact`}>Get in touch</a>
        </div>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p class="mono">Static Astro build · no trackers · press <kbd>⌘K</kbd></p>
      </div>
    </footer>

    <CommandPalette />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Fresh page loads always start at the top. Some embedding hosts keep the
      // previous page's scroll offset; scrollIntoView also moves those ancestors.
      const navEntry = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (!location.hash && navEntry?.type === 'navigate') {
        document.documentElement.scrollIntoView({ block: 'start', behavior: 'instant' });
      }

      // Reveal-on-scroll
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Nav background on scroll
      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Pointer spotlight: one listener, positions written as CSS vars
      if (!reduced) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const el = (e.target as Element | null)?.closest<HTMLElement>('.spot');
            if (!el) return;
            const r = el.getBoundingClientRect();
            el.style.setProperty('--x', `${e.clientX - r.left}px`);
            el.style.setProperty('--y', `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      }
    </script>

    <style>
      .preview-banner {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 200;
        font-size: 0.74rem;
        padding: 8px 14px;
        border-radius: 980px;
        background: var(--surface);
        border: 1px solid #e8a200;
        color: var(--text-secondary);
        box-shadow: var(--shadow-md);
        width: max-content;
        max-width: calc(100vw - 32px);
        text-align: center;
      }
      .tbc-sample {
        text-decoration: underline dashed #e8a200;
        text-underline-offset: 3px;
      }
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background 0.3s ease, border-color 0.3s ease;
        border-bottom: 1px solid transparent;
      }
      .nav.scrolled {
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom-color: var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        gap: 16px;
      }
      .nav-brand {
        font-weight: 600;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
      }
      .nav-links {
        display: flex;
        gap: 28px;
      }
      .nav-links a {
        font-size: 0.9rem;
        color: var(--text-secondary);
        transition: color 0.2s ease;
      }
      .nav-links a:hover {
        color: var(--text);
      }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .nav-k {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font: inherit;
        font-size: 0.85rem;
        color: var(--text-secondary);
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 980px;
        padding: 5px 6px 5px 12px;
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .nav-k:hover {
        color: var(--text);
        border-color: var(--border-strong);
      }
      .nav-cta {
        font-size: 0.9rem;
        font-weight: 500;
        padding: 7px 16px;
        border-radius: 980px;
        background: var(--accent);
        color: #fff;
        transition: background 0.2s ease;
      }
      .nav-cta:hover {
        background: var(--accent-hover);
      }
      .footer {
        padding: 40px 0 72px;
        border-top: 1px solid var(--border);
        color: var(--text-tertiary);
        font-size: 0.85rem;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .footer .mono {
        font-size: 0.78rem;
      }
      @media (max-width: 860px) {
        .nav-links {
          display: none;
        }
      }
      @media (max-width: 480px) {
        .nav-k-label,
        .nav-cta {
          display: none;
        }
      }
    </style>
  </body>
</html>
