---
// Experiment: the site's content as an interactive three.js network.
// Not linked from the main site and kept out of the index; the plain
// site at / stays the canonical version.
import Tbc from '../components/Tbc.astro';
import { profile, experience, clientApps, education, certifications } from '../data/portfolio';
import { caseStudies, process } from '../data/work';
import { shortCompany, clientName, clip, publications, contacts, groups } from '../three/content';

const title = `${profile.name} · 3D`;
const canonical = new URL('/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#08080d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>
    <div id="labels" aria-hidden="true"></div>

    <header class="top">
      <a class="brand" href="/3d/">{profile.name}</a>
      <nav class="chips" aria-label="Sections">
        {
          groups.map((g) => (
            <button type="button" data-go={g.id} style={`--c:${g.color}`}>
              {g.label}
            </button>
          ))
        }
      </nav>
      <a class="plain-link" href="/">Plain version</a>
    </header>

    <div class="hero">
      <h1>{profile.headline}</h1>
      <p class="lead">{profile.intro[0]}</p>
      <p class="hint">Drag to look around · click a node to read · grab one and let go</p>
    </div>

    <main id="panel" class="panel" tabindex="-1">
      <button type="button" class="close" data-close aria-label="Close">✕</button>

      <article data-node="root" data-kind="root" data-label={profile.name} data-color="#f4f4ff">
        <p class="meta">{profile.role} · {profile.location}</p>
        <h2>{profile.name}</h2>
        <p>{profile.about}</p>
        <p>{profile.intro[1]}</p>
        <p>{process}</p>
        <p class="small">
          {education.map((e) => `${e.degree} in ${e.field}`).join(', ')}, {education[0].school}.{' '}
          {certifications.join(', ')}.
        </p>
        <ul class="jump">
          {
            groups.map((g) => (
              <li>
                <button type="button" data-go={g.id}>{g.label}</button>
              </li>
            ))
          }
        </ul>
      </article>

      {
        groups.map((g) => (
          <article data-node={g.id} data-kind="group" data-parent="root" data-label={g.label} data-color={g.color}>
            <p class="meta">{g.items.length} nodes</p>
            <h2>{g.label}</h2>
            <ul class="jump">
              {g.items.map((item, i) => (
                <li>
                  <button type="button" data-go={`${g.id}-${i}`}>{item}</button>
                </li>
              ))}
            </ul>
          </article>
        ))
      }

      {
        caseStudies.map((c, i) => (
          <article data-node={`projects-${i}`} data-kind="leaf" data-parent="projects" data-label={c.name}>
            <button type="button" class="crumb" data-go="projects">Projects</button>
            <p class="meta">{c.kind} · {c.sector}</p>
            <h2><Tbc claim={c.nameClaim}>{c.name}</Tbc></h2>
            <p class="strong">{c.headline}</p>
            <p>{c.pitch}</p>
            <p class="small"><Tbc claim={c.roleClaim}>{c.role}</Tbc></p>
            <ul class="tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
            <div class="actions">
              <a class="btn" href={`/work/${c.slug}/`}>Read the case study</a>
              <a href={c.url} target="_blank" rel="noopener">{c.linkLabel} ↗</a>
            </div>
          </article>
        ))
      }

      {
        clientApps.map((a, i) => (
          <article data-node={`clients-${i}`} data-kind="leaf" data-parent="clients" data-label={clientName(a.name)}>
            <button type="button" class="crumb" data-go="clients">Client teams</button>
            <p class="meta">With the client team</p>
            <h2>{clientName(a.name)}</h2>
            <p>{a.descriptor}</p>
            <div class="actions">
              <a class="btn" href={a.href} target="_blank" rel="noopener">Open ↗</a>
            </div>
          </article>
        ))
      }

      {
        experience.map((job, i) => (
          <article data-node={`experience-${i}`} data-kind="leaf" data-parent="experience" data-label={shortCompany(job.company)}>
            <button type="button" class="crumb" data-go="experience">Experience</button>
            <p class="meta">{job.role}</p>
            <h2>{shortCompany(job.company)}</h2>
            <p>{job.summary}</p>
            {job.highlights.length > 0 && (
              <ul class="bullets">{job.highlights.map((h) => <li>{h}</li>)}</ul>
            )}
          </article>
        ))
      }

      {
        publications.map((pub, i) => (
          <article data-node={`writing-${i}`} data-kind="leaf" data-parent="writing" data-label={clip(pub.title)}>
            <button type="button" class="crumb" data-go="writing">Writing</button>
            <p class="meta">{pub.venue}</p>
            <h2 class="long">{pub.title}</h2>
            <div class="actions">
              <a class="btn" href={pub.href} target="_blank" rel="noopener">Read the paper ↗</a>
            </div>
          </article>
        ))
      }

      {
        contacts.map((ct, i) => (
          <article data-node={`contact-${i}`} data-kind="leaf" data-parent="contact" data-label={ct.label}>
            <button type="button" class="crumb" data-go="contact">Contact</button>
            <p class="meta">{profile.location}</p>
            <h2>{ct.label}</h2>
            <p class="value">{ct.value}</p>
            <div class="actions">
              <a class="btn" href={ct.href} target={ct.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">{ct.cta}</a>
            </div>
          </article>
        ))
      }
    </main>

    <script>
      import { start } from '../three/scene';
      start();
    </script>

    <style is:global>
      :root {
        --sans: 'Hanken Grotesk', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        --bg: #08080d;
        --text: #ececf4;
        --text-2: #a9a9bb;
        --text-3: #74748a;
        --line: rgba(255, 255, 255, 0.1);
        --c: #7aa2ff;
        color-scheme: dark;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
      }
      body {
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.6;
        background: var(--bg);
        color: var(--text);
      }
      a {
        color: inherit;
        text-underline-offset: 3px;
        text-decoration-color: var(--line);
      }
      a:hover {
        text-decoration-color: currentColor;
      }
      button {
        font: inherit;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer;
      }
      ul {
        list-style: none;
      }
      :focus-visible {
        outline: 2px solid var(--c);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* ── Without WebGL: a plain, readable document ── */
      #scene,
      #labels,
      .chips,
      .close,
      .crumb,
      .jump,
      .hint {
        display: none;
      }
      .top,
      .hero,
      .panel {
        max-width: 720px;
        margin-inline: auto;
        padding-inline: 24px;
      }
      .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-block: 24px;
      }
      .brand {
        font-weight: 600;
        text-decoration: none;
      }
      .plain-link {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text-2);
        text-decoration: none;
        white-space: nowrap;
      }
      .plain-link:hover {
        color: var(--text);
      }
      .hero {
        padding-block: 32px;
      }
      h1 {
        font-size: clamp(2rem, 5.2vw, 3.5rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
        text-wrap: balance;
        max-width: 14ch;
      }
      .lead {
        margin-top: 14px;
        font-size: 1.05rem;
        color: var(--text-2);
        max-width: 38ch;
      }
      .panel:focus {
        outline: none;
      }
      article {
        padding-block: 24px;
        border-top: 1px solid var(--line);
      }
      article > * + * {
        margin-top: 12px;
      }
      .meta {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--c);
      }
      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-top: 6px;
        overflow-wrap: anywhere;
      }
      h2.long {
        font-size: 1.2rem;
        letter-spacing: -0.01em;
      }
      article p {
        color: var(--text-2);
      }
      article p.strong {
        color: var(--text);
        font-weight: 500;
      }
      article p.small {
        font-size: 13px;
        color: var(--text-3);
      }
      article p.value {
        overflow-wrap: anywhere;
      }
      .bullets {
        display: grid;
        gap: 8px;
      }
      .bullets li {
        position: relative;
        padding-left: 16px;
        color: var(--text-2);
      }
      .bullets li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--c);
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .tags li {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--text-2);
        padding: 3px 9px;
        border: 1px solid var(--line);
        border-radius: 980px;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        margin-top: 18px;
        font-size: 14px;
      }
      .btn {
        display: inline-block;
        padding: 9px 16px;
        border-radius: 980px;
        background: var(--c);
        color: #0a0a12;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.15s ease;
      }
      .btn:hover {
        transform: translateY(-1px);
      }

      /* ── With WebGL: full-screen scene, content in a floating panel ── */
      html.gl,
      html.gl body {
        height: 100%;
        overflow: hidden;
        overscroll-behavior: none;
      }
      .gl #scene {
        display: block;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        touch-action: none;
        outline: none;
      }
      .gl #labels {
        display: block;
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }
      .lbl {
        position: absolute;
        left: 0;
        top: 0;
        white-space: nowrap;
        font-family: var(--mono);
        font-size: 11px;
        color: #c9c9d8;
        text-shadow:
          0 0 6px var(--bg),
          0 0 3px var(--bg),
          0 0 1px var(--bg);
        will-change: transform, opacity;
      }
      .lbl-group,
      .lbl-root {
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
      }
      .lbl.on {
        color: var(--c);
      }

      .gl .top {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 3;
        max-width: none;
        padding: 18px 22px;
        pointer-events: none;
      }
      .gl .top > * {
        pointer-events: auto;
      }
      .gl .chips {
        display: flex;
        gap: 6px;
        padding: 4px;
        border-radius: 980px;
        border: 1px solid var(--line);
        background: rgba(14, 14, 22, 0.6);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      .chips button {
        padding: 5px 12px;
        border-radius: 980px;
        font-size: 13px;
        color: var(--text-2);
        white-space: nowrap;
        transition:
          color 0.15s ease,
          background 0.15s ease;
      }
      .chips button:hover {
        color: var(--text);
      }
      .chips button[aria-current] {
        background: var(--c);
        color: #0a0a12;
        font-weight: 500;
      }

      .gl .hero {
        position: fixed;
        left: 0;
        bottom: 0;
        z-index: 1;
        max-width: none;
        margin: 0;
        padding: 0 28px 30px;
        pointer-events: none;
        transition:
          opacity 0.4s ease,
          transform 0.4s ease;
      }
      .gl .has-sel .hero {
        opacity: 0;
        transform: translateY(10px);
      }
      .gl .hint {
        display: block;
        margin-top: 18px;
        font-family: var(--mono);
        font-size: 11.5px;
        color: var(--text-3);
        transition: opacity 0.6s ease;
      }
      .gl .touched .hint {
        opacity: 0;
      }

      .gl .panel {
        position: fixed;
        z-index: 2;
        top: 78px;
        right: 22px;
        bottom: 22px;
        width: min(400px, calc(100vw - 44px));
        max-width: none;
        margin: 0;
        padding: 26px 26px 30px;
        overflow-y: auto;
        overscroll-behavior: contain;
        border-radius: 20px;
        border: 1px solid var(--line);
        border-top-color: color-mix(in srgb, var(--c) 45%, transparent);
        background: rgba(14, 14, 22, 0.72);
        -webkit-backdrop-filter: blur(20px) saturate(1.2);
        backdrop-filter: blur(20px) saturate(1.2);
        opacity: 0;
        visibility: hidden;
        transform: translateX(16px) scale(0.985);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease,
          visibility 0s 0.3s;
      }
      .gl .panel.open {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }
      .gl article {
        display: none;
        padding: 0;
        border: 0;
      }
      .gl article.active {
        display: block;
        animation: rise 0.35s ease both;
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
      }
      .gl .close {
        display: grid;
        place-items: center;
        position: sticky;
        top: 0;
        float: right;
        width: 30px;
        height: 30px;
        margin: -8px -8px 0 8px;
        border-radius: 50%;
        font-size: 12px;
        color: var(--text-2);
        background: rgba(255, 255, 255, 0.07);
      }
      .gl .close:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.14);
      }
      .gl .crumb {
        display: inline-block;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text-3);
      }
      .crumb::before {
        content: '← ';
      }
      .crumb:hover {
        color: var(--text);
      }
      .gl .jump {
        display: grid;
        margin-top: 16px;
      }
      .jump button {
        display: flex;
        align-items: baseline;
        gap: 10px;
        width: 100%;
        padding: 10px 0;
        text-align: left;
        border-top: 1px solid var(--line);
        color: var(--text);
        transition: color 0.15s ease;
      }
      .jump button::before {
        content: '';
        flex: none;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--c);
        transform: translateY(-2px);
      }
      .jump button:hover {
        color: var(--c);
      }

      @media (max-width: 760px) {
        .gl .top {
          flex-wrap: wrap;
          padding: 14px 16px;
          gap: 10px;
        }
        .gl .chips {
          order: 3;
          width: 100%;
          overflow-x: auto;
          scrollbar-width: none;
        }
        .gl .hero {
          padding: 0 18px 22px;
        }
        .gl .panel {
          top: auto;
          left: 10px;
          right: 10px;
          bottom: 10px;
          width: auto;
          max-height: 48dvh;
          padding: 22px 20px 24px;
          transform: translateY(16px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
