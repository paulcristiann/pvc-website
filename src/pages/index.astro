---
import Layout from '../layouts/Layout.astro';
import ToptalBadge from '../components/ToptalBadge.astro';
import LinkedInBadge from '../components/LinkedInBadge.astro';
import {
  profile,
  experience,
  projects,
  clientApps,
  stats,
  education,
} from '../data/portfolio';
---

<Layout>
  {/* ───────────── Hero ───────────── */}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="hero-role reveal">{profile.role}</p>
        <h1 class="hero-name reveal">{profile.name}</h1>
        <p class="hero-tagline reveal">{profile.tagline}</p>
        <div class="hero-actions reveal">
          <a class="btn btn-primary" href="#projects">View my work</a>
          <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Email me</a>
        </div>
      </div>
      <div class="hero-badge reveal">
        <ToptalBadge />
      </div>
    </div>
  </section>

  {/* ───────────── About ───────────── */}
  <section id="about">
    <div class="container">
      <p class="eyebrow reveal">About</p>
      <h2 class="section-title reveal">A bit about me</h2>
      <p class="about-text reveal">{profile.about}</p>
      <div class="about-badge reveal">
        <LinkedInBadge />
      </div>
      <p class="about-meta reveal">📍 {profile.location}</p>
    </div>
  </section>

  {/* ───────────── Experience ───────────── */}
  <section id="experience">
    <div class="container">
      <p class="eyebrow reveal">Experience</p>
      <h2 class="section-title reveal">Where I've worked</h2>
      <div class="stats reveal">
        {
          stats.map((s) => (
            <div class="stat">
              <p class="stat-value">{s.value}</p>
              <p class="stat-label">{s.label}</p>
            </div>
          ))
        }
      </div>
      <div class="timeline">
        {
          experience.map((job) => (
            <article class="card timeline-item reveal">
              <div class="timeline-head">
                <div>
                  <h3>{job.role}</h3>
                  <p class="timeline-company">{job.company}</p>
                </div>
              </div>
              <p class="timeline-summary">{job.summary}</p>
              <ul class="timeline-highlights">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <div class="timeline-tags">
                {job.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              {job.publications && (
                <div class="timeline-pubs">
                  <p class="pubs-title">Selected publications</p>
                  {job.publications.map((pub) => (
                    <a class="pub-item" href={pub.href} target="_blank" rel="noopener">
                      <svg
                        class="pub-icon"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                      </svg>
                      <span>
                        <span class="pub-name">{pub.title}</span>
                        <span class="pub-venue">{pub.venue}</span>
                      </span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ───────────── Projects ───────────── */}
  <section id="projects">
    <div class="container">
      <p class="eyebrow reveal">Apps</p>
      <h2 class="section-title reveal">Built solo, end to end</h2>
      <p class="section-lead reveal">
        Most of my work ships inside client products. These are different —
        I own everything: product, design, architecture, code, and release.
        From first sketch to v1.0 and beyond.
      </p>
      <div class="project-grid">
        {
          projects.map((p) => (
            <article class="card project-card reveal">
              <div class="project-head">
                <img
                  class="project-icon"
                  src={p.icon}
                  alt={`${p.name} app icon`}
                  width="64"
                  height="64"
                  loading="lazy"
                />
                <div>
                  <span class:list={['project-kind', { client: p.kind === 'Client work' }]}>
                    {p.kind}
                  </span>
                  <h3>{p.name}</h3>
                </div>
              </div>
              <p class="project-desc">{p.description}</p>
              <div class="project-tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <div class="project-links">
                {p.appStore && (
                  <a href={p.appStore} target="_blank" rel="noopener">
                    App Store ↗
                  </a>
                )}
                {p.website && (
                  <a href={p.website} target="_blank" rel="noopener">
                    Website ↗
                  </a>
                )}
                {p.href && (
                  <a href={p.href} target="_blank" rel="noopener">
                    Source ↗
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <h3 class="subsection-title reveal">With client teams</h3>
      <p class="section-lead reveal">
        A few of the products I've helped build alongside client teams — from
        real-estate marketplaces to retail at enterprise scale.
      </p>
      <div class="client-apps">
        {
          clientApps.map((app) => (
            <a class="card client-app reveal" href={app.href} target="_blank" rel="noopener">
              <img
                class="client-app-icon"
                src={app.icon}
                alt={`${app.name} app icon`}
                width="64"
                height="64"
                loading="lazy"
              />
              <div>
                <p class="client-app-name">{app.name} <span class="client-app-arrow">↗</span></p>
                <p class="client-app-desc">{app.descriptor}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ───────────── Education ───────────── */}
  <section id="education">
    <div class="container">
      <p class="eyebrow reveal">Education</p>
      <h2 class="section-title reveal">Grounded in theory, proven in practice</h2>
      <div class="education-grid">
        {
          education.map((e) => (
            <div class="card education-card reveal">
              <svg
                class="education-icon"
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 10 12 5 2 10l10 5 10-5z" />
                <path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" />
                <path d="M22 10v6" />
              </svg>
              <p class="education-degree">{e.degree}</p>
              <h3 class="education-field">{e.field}</h3>
              <p class="education-school">{e.school}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ───────────── Contact ───────────── */}
  <section id="contact" class="contact">
    <div class="container">
      <p class="eyebrow reveal">Contact</p>
      <h2 class="section-title reveal">Let's build something</h2>
      <p class="contact-text reveal">
        I'm always happy to talk about iOS, new opportunities, or a project you
        have in mind.
      </p>
      <div class="contact-actions reveal">
        <a class="btn btn-primary contact-btn" href={`mailto:${profile.email}`}>
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="3" />
            <path d="m3 6 9 7 9-7" />
          </svg>
          {profile.email}
        </a>
        <a
          class="btn btn-whatsapp contact-btn"
          href={`https://wa.me/${profile.whatsappNumber}`}
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            />
          </svg>
          Chat on WhatsApp
        </a>
      </div>
      <div class="socials reveal">
        {
          profile.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    background: radial-gradient(
        120% 120% at 50% 0%,
        color-mix(in srgb, var(--accent) 8%, transparent) 0%,
        transparent 55%
      );
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 48px;
  }
  .hero-badge {
    justify-self: center;
    /* subtle float animation */
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (max-width: 780px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-badge {
      justify-self: start;
      margin-top: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-badge {
      animation: none;
    }
  }
  .hero-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .hero-name {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-bottom: 22px;
  }
  .hero-tagline {
    font-size: clamp(1.15rem, 3vw, 1.6rem);
    color: var(--text-secondary);
    max-width: 40ch;
    font-weight: 400;
    margin-bottom: 36px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 980px;
    font-size: 1rem;
    font-weight: 500;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
  }
  .btn-ghost {
    background: transparent;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .btn-ghost:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* About */
  .about-badge {
    margin-top: 32px;
  }
  .about-text {
    font-size: clamp(1.3rem, 3.2vw, 1.9rem);
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .about-text {
    max-width: 42ch;
  }
  .about-meta {
    margin-top: 20px;
    color: var(--text-secondary);
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  .stat {
    padding: 26px 28px;
    border-radius: var(--radius);
    background: var(--surface-2);
    text-align: center;
  }
  .stat-value {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
    line-height: 1.1;
  }
  .stat-label {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .timeline-item {
    padding: 28px 30px;
  }
  .timeline-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .timeline-head h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .timeline-company {
    color: var(--accent);
    font-weight: 500;
    margin-top: 2px;
  }
  .timeline-summary {
    margin: 14px 0;
    color: var(--text-secondary);
  }
  .timeline-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .timeline-highlights li {
    position: relative;
    padding-left: 22px;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .timeline-highlights li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .timeline-pubs {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .pubs-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 10px;
  }
  .pub-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 0;
  }
  .pub-icon {
    flex-shrink: 0;
    color: var(--accent);
    transform: translateY(2px);
  }
  .pub-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
    transition: color 0.2s ease;
  }
  .pub-item:hover .pub-name {
    color: var(--accent);
  }
  .pub-venue {
    display: block;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-top: 1px;
  }

  /* Projects */
  .section-lead {
    margin: -24px 0 40px;
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 52ch;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .project-card {
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .project-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }
  .project-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 15px; /* iOS icon curvature at 64px */
    border: 1px solid var(--border);
    object-fit: cover;
  }
  .project-kind {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 4px 12px;
    border-radius: 980px;
    margin-bottom: 8px;
  }
  .project-kind.client {
    color: var(--text-secondary);
    background: var(--surface-2);
  }
  .project-card h3 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0;
    line-height: 1.25;
  }
  .project-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 18px;
    flex: 1;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 980px;
    background: var(--surface-2);
    color: var(--text-secondary);
  }
  .project-links {
    display: flex;
    gap: 18px;
    margin-top: 18px;
  }
  .project-links a {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .project-links a:hover {
    text-decoration: underline;
  }
  /* Client apps showcase */
  .subsection-title {
    margin-top: 64px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 40px;
  }
  .client-apps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (max-width: 640px) {
    .client-apps {
      grid-template-columns: 1fr;
    }
  }
  .client-app {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 24px;
  }
  .client-app-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 15px; /* iOS icon curvature at 64px */
    border: 1px solid var(--border);
    object-fit: cover;
  }
  .client-app-name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .client-app-arrow {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }
  .client-app-desc {
    margin-top: 3px;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  /* Education */
  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (max-width: 640px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
  }
  .education-card {
    padding: 28px 30px;
  }
  .education-icon {
    color: var(--accent);
    margin-bottom: 16px;
  }
  .education-degree {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .education-field {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .education-school {
    margin-top: 6px;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* Contact */
  .contact {
    text-align: center;
    background: var(--surface-2);
  }
  .contact .eyebrow {
    text-align: center;
  }
  .contact-text {
    color: var(--text-secondary);
    max-width: 44ch;
    margin: 0 auto 32px;
    font-size: 1.1rem;
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .contact-btn {
    gap: 10px;
  }
  .btn-whatsapp {
    background: #25d366;
    color: #fff;
  }
  .btn-whatsapp:hover {
    background: #1fbd5a;
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin-top: 36px;
  }
  .socials a {
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .socials a:hover {
    color: var(--accent);
  }
</style>
