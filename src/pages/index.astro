---
import Layout from '../layouts/Layout.astro';
import Tbc from '../components/Tbc.astro';
import { profile, experience, clientApps, education, certifications } from '../data/portfolio';
import { caseStudies, process } from '../data/work';

const publications = experience.flatMap((job) => job.publications ?? []);
const year = (venue: string) => venue.match(/\d{4}/)?.[0] ?? '';
const shortCompany = (company: string) =>
  company
    .replace('National Institute for Research & Development in Informatics (ICI)', 'ICI Bucharest')
    .replace(' · client platforms', '');
const shortRole = (role: string) => role.replace(' · Top 3%', '');
---

<Layout>
  <div class="container">
    <section class="row intro" aria-labelledby="intro-title">
      <p class="row-label">About</p>
      <div>
        <h1 id="intro-title">{profile.headline}</h1>
        {profile.intro.map((line, i) => <p class:list={['lead', { 'lead-small': i > 0 }]}>{line}</p>)}
      </div>
    </section>

    <section id="work" class="row" aria-labelledby="work-label">
      <h2 id="work-label" class="row-label">Projects</h2>
      <ul>
        {
          caseStudies.map((c) => (
            <li class="entry">
              <a class="entry-name" href={`/work/${c.slug}/`}>
                <Tbc claim={c.nameClaim}>{c.name}</Tbc>
              </a>
              <span class="entry-meta">{c.kind}</span>
              <p class="entry-desc">{c.short}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row" aria-labelledby="clients-label">
      <h2 id="clients-label" class="row-label">With client teams</h2>
      <p class="plain">
        {
          clientApps.map((app, i) => (
            <>
              <a href={app.href} target="_blank" rel="noopener" title={app.descriptor}>
                {app.name === 'M&S' ? 'Marks & Spencer' : app.name}
              </a>
              {i < clientApps.length - 1 ? ', ' : '.'}
            </>
          ))
        }
      </p>
    </section>

    <section id="experience" class="row" aria-labelledby="experience-label">
      <h2 id="experience-label" class="row-label">Experience</h2>
      <ul>
        {
          experience.map((job) => (
            <li class="entry">
              <span class="entry-name">{shortCompany(job.company)}</span>
              <span class="entry-meta">{shortRole(job.role)}</span>
              <p class="entry-desc">{job.summary}</p>
              {job.highlights.length > 0 && (
                <details class="entry-desc">
                  <summary>Details</summary>
                  <ul class="bullets">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row" aria-labelledby="process-label">
      <h2 id="process-label" class="row-label">Process</h2>
      <p class="plain">{process}</p>
    </section>

    <section class="row" aria-labelledby="writing-label">
      <h2 id="writing-label" class="row-label">Writing</h2>
      <ul>
        {
          publications.map((pub) => (
            <li class="entry">
              <a class="entry-name" href={pub.href} target="_blank" rel="noopener">
                {pub.title}
              </a>
              <span class="entry-meta">{year(pub.venue)}</span>
              <p class="entry-desc venue">{pub.venue.replace(/\s*·\s*\d{4}$/, '')}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row" aria-labelledby="education-label">
      <h2 id="education-label" class="row-label">Education</h2>
      <p class="plain">
        {education.map((e) => `${e.degree} in ${e.field}`).join(', ')}, {education[0].school}.{' '}
        {certifications.join(', ')}.
      </p>
    </section>

    <section id="contact" class="row" aria-labelledby="contact-label">
      <h2 id="contact-label" class="row-label">Contact</h2>
      <div>
        <div class="links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={`https://wa.me/${profile.whatsappNumber}`} target="_blank" rel="noopener">WhatsApp</a>
          {
            profile.socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
              </a>
            ))
          }
        </div>
        <p class="location">{profile.location}</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .intro {
    border-top: 0;
    padding-top: 0;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 56ch;
    margin-top: 8px;
  }
  .lead-small {
    font-size: 1rem;
    margin-top: 12px;
  }
  .plain a {
    color: var(--text);
    text-underline-offset: 3px;
    text-decoration-color: var(--line);
  }
  .plain a:hover {
    text-decoration-color: currentColor;
  }
  .venue {
    font-size: 13px;
    color: var(--text-tertiary);
  }
  .location {
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-tertiary);
  }
</style>
