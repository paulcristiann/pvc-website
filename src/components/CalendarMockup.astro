---
// Stylized, data-free mockup of the clinic's weekly calendar.
// Overlapping appointments sit side by side, coloured by doctor.
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
// [day, startRow, span, doctor, lane, lanes]
const blocks: [number, number, number, number, number, number][] = [
  [0, 1, 2, 0, 0, 1],
  [0, 4, 2, 1, 0, 1],
  [1, 2, 3, 2, 0, 2],
  [1, 3, 2, 0, 1, 2],
  [2, 1, 1, 1, 0, 1],
  [2, 3, 3, 0, 0, 1],
  [3, 2, 2, 1, 0, 2],
  [3, 2, 3, 2, 1, 2],
  [4, 1, 2, 2, 0, 1],
  [4, 5, 2, 0, 0, 1],
];
---

<div class="cal" aria-hidden="true">
  <div class="cal-head">
    {days.map((d) => <span>{d}</span>)}
  </div>
  <div class="cal-grid">
    {days.map((_, i) => <div class="cal-col" style={`grid-column:${i + 1}`} />)}
    {
      blocks.map(([day, start, span, doc, lane, lanes], i) => (
        <div
          class={`cal-block d${doc}`}
          style={`grid-column:${day + 1};grid-row:${start}/span ${span};--lane:${lane};--lanes:${lanes};--i:${i}`}
        >
          <i />
          <i />
        </div>
      ))
    }
  </div>
</div>

<style>
  .cal {
    width: 100%;
    font-family: var(--font-mono);
  }
  .cal-head {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    font-size: 0.66rem;
    color: var(--text-tertiary);
    margin-bottom: 8px;
    padding-left: 2px;
  }
  .cal-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(7, 22px);
    gap: 4px 6px;
  }
  .cal-col {
    grid-row: 1 / -1;
    border-radius: 8px;
    background: repeating-linear-gradient(
      to bottom,
      var(--surface-2) 0 22px,
      transparent 22px 26px
    );
  }
  .cal-block {
    position: relative;
    width: calc(100% / var(--lanes) - 2px);
    margin-left: calc(100% / var(--lanes) * var(--lane));
    border-radius: 7px;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 16%, var(--surface));
    transform-origin: top;
    transition: transform 0.5s var(--ease), opacity 0.5s var(--ease);
    transition-delay: calc(var(--i) * 40ms);
  }
  .cal-block i {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--c) 45%, transparent);
  }
  .cal-block i + i {
    width: 60%;
  }
  .d0 {
    --c: #0a84ff;
  }
  .d1 {
    --c: #30b566;
  }
  .d2 {
    --c: #c86dd7;
  }
  :global(.reveal:not(.is-visible)) .cal-block {
    opacity: 0;
    transform: scaleY(0.6);
  }
</style>
