---
import Layout from '../../layouts/Layout.astro';
import Tbc from '../../components/Tbc.astro';
import { caseStudies, type CaseStudy } from '../../data/work';
import { claims } from '../../data/confirm';
import { caseStudyGraph } from '../../data/seo';

export function getStaticPaths() {
  return caseStudies.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

interface Props {
  c: CaseStudy;
  next: CaseStudy;
}

const { c, next } = Astro.props;
// Link the live site only once the client has agreed to be named.
const canLink = !c.nameClaim || claims[c.nameClaim].confirmed;
---

<Layout
  title={`${c.name}: ${c.headline} · Paul Vasile`}
  description={c.pitch}
  ogType="article"
  schema={caseStudyGraph(c.slug)}
>
  <article class="container">
    <header class="row cs-head">
      <a class="row-label back" href="/#work">← All work</a>
      <div>
        <p class="cs-name"><Tbc claim={c.nameClaim}>{c.name}</Tbc></p>
        <h1>{c.headline}</h1>
        <p class="lead">{c.pitch}</p>
        <dl class="facts">
          <dt>Role</dt>
          <dd><Tbc claim={c.roleClaim}>{c.role}</Tbc></dd>
          <dt>Type</dt>
          <dd>{c.kind}</dd>
          <dt>Industry</dt>
          <dd>{c.sector}</dd>
          {
            canLink && (
              <>
                <dt>Links</dt>
                <dd class="links">
                  <a href={c.url} target="_blank" rel="noopener">
                    {c.linkLabel} ↗
                  </a>
                  {c.visit.secondary && (
                    <a href={c.visit.secondary.url} target="_blank" rel="noopener">
                      {c.visit.secondary.label} ↗
                    </a>
                  )}
                </dd>
              </>
            )
          }
        </dl>
      </div>
    </header>

    <section class="row">
      <h2 class="row-label">{c.clientHeading ?? 'Client'}</h2>
      <p class="plain"><Tbc claim={c.nameClaim}>{c.client}</Tbc></p>
    </section>

    <section class="row">
      <h2 class="row-label">The problem</h2>
      <div>
        <p class="plain">{c.challenge.intro}</p>
        <ul class="bullets spaced">
          {c.challenge.needs.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </section>

    <section class="row">
      <h2 class="row-label">What I built</h2>
      <div class="groups">
        {
          c.delivered.map((g) => (
            <div>
              <h3 class="group-title">{g.title}</h3>
              <ul class="bullets">
                {g.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row">
      <h2 class="row-label">How it holds up</h2>
      <ul>
        {
          c.howIBuild.map((b) => (
            <li class="entry">
              <span class="entry-name">{b.title}</span>
              <p class="entry-desc">{b.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row">
      <h2 class="row-label">Outcome</h2>
      <ul>
        {
          c.results.map((r) => (
            <li class="entry">
              <span class="entry-name">{r.title}</span>
              <p class="entry-desc">{r.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      c.quote && (
        <section class="row">
          <h2 class="row-label">Quote</h2>
          <blockquote class="plain">“{c.quote}”</blockquote>
        </section>
      )
    }

    <nav class="row" aria-label="Next project">
      <p class="row-label">Next</p>
      <a class="entry-name" href={`/work/${next.slug}/`}>{next.name}: {next.headline} →</a>
    </nav>
  </article>
</Layout>

<style>
  .cs-head {
    border-top: 0;
    padding-top: 0;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  .cs-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 60ch;
    margin-top: 10px;
  }
  .facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px 20px;
    margin-top: 24px;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    padding-top: 2px;
  }
  .facts dd {
    color: var(--text-secondary);
  }
  .spaced {
    margin-top: 12px;
  }
  .groups {
    display: grid;
    gap: 20px;
  }
  .group-title {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 8px;
  }
  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .facts dd + dt {
      margin-top: 8px;
    }
  }
</style>
