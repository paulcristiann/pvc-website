---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found · Paul Vasile" description="This page doesn’t exist." noindex>
  <div class="container">
    <section class="row nf">
      <p class="row-label">404</p>
      <div>
        <h1>This page doesn’t exist.</h1>
        <p class="plain">The link may be old or mistyped. <a href="/">Go to the home page →</a></p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .nf {
    border-top: 0;
    padding-top: 0;
    min-height: 40vh;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 8px;
  }
</style>
