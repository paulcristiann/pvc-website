---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found · Paul Vasile" description="This page doesn’t exist." noindex>
  <section class="nf container">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="nf-text">The link may be old or mistyped. The work and contact details are on the home page.</p>
    <a class="btn btn-primary" href="/">Go to the home page <span class="arrow">→</span></a>
  </section>
</Layout>

<style>
  .nf {
    padding: 180px 0 120px;
  }
  .nf h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 14px;
  }
  .nf-text {
    color: var(--text-secondary);
    max-width: 52ch;
    margin-bottom: 28px;
  }
</style>
