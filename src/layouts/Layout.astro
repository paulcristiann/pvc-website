---
import '../styles/global.css';
import { profile } from '../data/portfolio';
import { pendingClaims } from '../data/confirm';
import { homeTitle, homeDescription, person, website } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD nodes for this page, merged into the site graph */
  schema?: object[];
  noindex?: boolean;
}

const { title = homeTitle, description = homeDescription, ogType = 'website', schema = [], noindex = false } = Astro.props;
const ogImage = new URL('/og.png', Astro.site).toString();
const jsonLd = { '@context': 'https://schema.org', '@graph': [person, website, ...schema] };

// Never publish unconfirmed claims. Preview locally with ALLOW_UNCONFIRMED=1.
if (import.meta.env.PROD && pendingClaims.length && process.env.ALLOW_UNCONFIRMED !== '1') {
  throw new Error(
    `Unconfirmed claims would go live. Confirm or remove them in src/data/confirm.ts:\n` +
      pendingClaims.map((c) => `  - ${c.key}: ${c.note}`).join('\n'),
  );
}

const home = Astro.url.pathname === '/' ? '' : '/';
const nav = [
  { label: 'Work', href: `${home}#work` },
  { label: 'Experience', href: `${home}#experience` },
  { label: 'Contact', href: `${home}#contact` },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="Profile for AI agents" href="/llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    {
      pendingClaims.length > 0 && (
        <div class="preview-banner mono" role="note">
          Preview · {pendingClaims.length} claims marked <span class="tbc-sample">like this</span> await
          confirmation
        </div>
      )
    }
    <header class="site-header container">
      <a class="brand" href="/">{profile.name}</a>
      <nav class="header-links" aria-label="Sections">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="container">
      <div class="site-footer">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>

    <style>
      .preview-banner {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 200;
        font-size: 0.74rem;
        padding: 8px 14px;
        border-radius: 980px;
        background: var(--bg);
        border: 1px solid #e8a200;
        color: var(--text-secondary);
        width: max-content;
        max-width: calc(100vw - 32px);
        text-align: center;
      }
      .tbc-sample {
        text-decoration: underline dashed #e8a200;
        text-underline-offset: 3px;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        flex-wrap: wrap;
        padding-block: 28px 48px;
      }
      .brand {
        font-weight: 600;
        text-decoration: none;
      }
      .header-links {
        display: flex;
        gap: 20px;
      }
      .header-links a,
      .site-footer a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .header-links a:hover,
      .site-footer a:hover {
        color: var(--text);
      }
      .site-footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-block: 28px 56px;
        margin-top: 24px;
        border-top: 1px solid var(--line);
        font-size: 13px;
        color: var(--text-tertiary);
      }
    </style>
  </body>
</html>
