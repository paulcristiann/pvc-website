---
import Layout from '../../layouts/Layout.astro';
import Tbc from '../../components/Tbc.astro';
import CaseVisual from '../../components/CaseVisual.astro';
import { caseStudies, type CaseStudy } from '../../data/work';
import { claims } from '../../data/confirm';

export function getStaticPaths() {
  return caseStudies.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

interface Props {
  c: CaseStudy;
  next: CaseStudy;
}

const { c, next } = Astro.props;
// Link the live site only once the client has agreed to be named.
const canLink = !c.nameClaim || claims[c.nameClaim].confirmed;
---

<Layout title={`${c.headline} · Paul Vasile`} description={c.pitch}>
  <article>
    <header class="cs-hero">
      <div class="container">
        <a class="back mono" href="/#work">← All work</a>
        <p class="eyebrow eyebrow-split">
          <span class="eb-part"><Tbc claim={c.nameClaim}>{c.name}</Tbc></span><span class="eb-sep eb-break"
            >&nbsp;· </span
          ><span class="eb-line">{c.sector}</span>
        </p>
        <h1 class="cs-title">{c.headline}</h1>
        <p class="cs-pitch">{c.pitch}</p>
        <dl class="cs-facts">
          <div>
            <dt class="mono">Role</dt>
            <dd><Tbc claim={c.roleClaim}>{c.role}</Tbc></dd>
          </div>
          <div>
            <dt class="mono">Type</dt>
            <dd>{c.kind}</dd>
          </div>
          <div>
            <dt class="mono">Industry</dt>
            <dd>{c.sector}</dd>
          </div>
          {
            canLink && (
              <div>
                <dt class="mono">See it</dt>
                <dd>
                  <a href={c.url} target="_blank" rel="noopener">
                    {c.linkLabel} ↗
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
        <div class="cs-visual card">
          <CaseVisual visual={c.visual} />
        </div>
      </div>
    </header>

    <section class="cs-section">
      <div class="container cs-grid">
        <h2 class="cs-h">{c.clientHeading ?? 'The client'}</h2>
        <div>
          <p class="cs-lead"><Tbc claim={c.nameClaim}>{c.client}</Tbc></p>
        </div>
      </div>
    </section>

    <section class="cs-section">
      <div class="container cs-grid">
        <h2 class="cs-h">The challenge</h2>
        <div>
          <p class="cs-text">{c.challenge.intro}</p>
          <ul class="cs-needs">
            {c.challenge.needs.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="cs-section">
      <div class="container cs-grid">
        <h2 class="cs-h">What I delivered</h2>
        <div class="cs-delivered">
          {
            c.delivered.map((g) => (
              <div class="cs-group">
                <h3 class="mono">{g.title}</h3>
                <ul>
                  {g.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cs-section cs-results">
      <div class="container">
        <h2 class="cs-h">Results</h2>
        <div class="results">
          {
            c.results.map((r) => (
              <div class="result card spot reveal">
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      canLink && (
        <section class="cs-section cs-visit-wrap">
          <div class="container">
            <div class="cs-visit card spot reveal">
              <div>
                <p class="cs-visit-eyebrow mono">
                  <span class="status-dot" /> Live
                </p>
                <h2 class="cs-visit-title">{c.visit.title}</h2>
                <p class="cs-visit-body">{c.visit.body}</p>
              </div>
              <div class="cs-visit-actions">
                <a class="cs-visit-btn" href={c.url} target="_blank" rel="noopener">
                  {c.visit.cta} <span aria-hidden="true">↗</span>
                </a>
                {c.visit.secondary && (
                  <a class="cs-visit-alt" href={c.visit.secondary.url} target="_blank" rel="noopener">
                    {c.visit.secondary.label} ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="cs-section">
      <div class="container cs-grid">
        <h2 class="cs-h">Built to hold up</h2>
        <div class="cs-build">
          {
            c.howIBuild.map((b) => (
              <div class="cs-build-item reveal">
                <span class="status-dot" />
                <div>
                  <h3>{b.title}</h3>
                  <p>{b.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      c.quote && (
        <section class="cs-section">
          <div class="container">
            <blockquote class="pull">
              <p>“{c.quote}”</p>
            </blockquote>
          </div>
        </section>
      )
    }

    <nav class="cs-next" aria-label="Next case study">
      <div class="container">
        <a class="next card spot" href={`/work/${next.slug}/`}>
          <span class="mono">Next case study</span>
          <span class="next-title">{next.headline} <span class="arrow">→</span></span>
        </a>
        <p class="cs-cta">
          Need something like this? <a href="/#contact">Let’s talk →</a>
        </p>
      </div>
    </nav>
  </article>
</Layout>

<style>
  .cs-hero {
    padding: 128px 0 40px;
  }
  .back {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 36px;
    transition: color 0.2s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .cs-title {
    font-size: clamp(2.3rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.04;
    max-width: 18ch;
    margin-bottom: 22px;
  }
  .cs-pitch {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 56ch;
  }
  .cs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 36px 0 48px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .cs-facts dt {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    margin-bottom: 4px;
  }
  .cs-facts dd {
    font-size: 0.95rem;
  }
  .cs-facts a {
    color: var(--accent);
  }
  .live {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cs-visual {
    padding: clamp(24px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    max-width: 760px;
  }

  .cs-visual :global(.cl),
  .cs-visual :global(.nb) {
    zoom: 1.4;
  }
  @media (max-width: 600px) {
    .cs-visual :global(.cl),
    .cs-visual :global(.nb) {
      zoom: 1;
    }
  }
  @media (max-width: 360px) {
    .cs-visual :global(.cl),
    .cs-visual :global(.nb) {
      zoom: 0.85;
    }
  }
  .cs-section {
    padding: 56px 0;
  }
  .cs-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
  }
  .cs-h {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .cs-lead {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    max-width: 40ch;
  }
  .cs-text {
    color: var(--text-secondary);
    max-width: 60ch;
    margin-bottom: 14px;
  }
  .cs-needs,
  .cs-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs-needs li,
  .cs-group li {
    position: relative;
    padding-left: 20px;
    max-width: 62ch;
  }
  .cs-needs li::before,
  .cs-group li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cs-delivered {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }
  .cs-group h3 {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }
  .cs-group li {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  .cs-results {
    background: var(--surface-2);
    padding: 72px 0;
  }
  .results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .result {
    padding: 26px;
  }
  .result h3 {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .result p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .cs-visit-wrap {
    padding-top: 72px;
  }
  .cs-visit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    flex-wrap: wrap;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      var(--surface);
  }
  .cs-visit-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    color: var(--signal);
    margin-bottom: 10px;
  }
  .cs-visit-title {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .cs-visit-body {
    color: var(--text-secondary);
    max-width: 48ch;
  }
  .cs-visit-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .cs-visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 980px;
    background: var(--accent);
    color: #fff;
    transition: background 0.2s ease, transform 0.2s var(--ease);
  }
  .cs-visit-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }
  .cs-visit-alt {
    font-size: 0.9rem;
    color: var(--accent);
    padding-left: 4px;
  }
  .cs-build {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 36px;
  }
  .cs-build-item {
    display: flex;
    gap: 16px;
    align-items: baseline;
  }
  .cs-build-item h3 {
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin-bottom: 4px;
  }
  .cs-build-item p {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }
  .pull {
    max-width: 30ch;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .pull p {
    border-left: 3px solid var(--accent);
    padding-left: 22px;
  }
  .cs-next {
    padding: 40px 0 104px;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 30px 32px;
    border-radius: var(--radius-lg);
  }
  .next .mono {
    font-size: 0.74rem;
    color: var(--text-tertiary);
  }
  .next-title {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .next:hover .arrow {
    transform: translateX(4px);
  }
  .cs-cta {
    margin-top: 28px;
    color: var(--text-secondary);
  }
  .cs-cta a {
    color: var(--accent);
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .cs-grid,
    .cs-delivered,
    .cs-build {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .results {
      grid-template-columns: 1fr;
    }
    .cs-grid .cs-h {
      margin-bottom: 0;
    }
  }
  @media (max-width: 600px) {
    .cs-section {
      padding: 44px 0;
    }
  }
</style>
