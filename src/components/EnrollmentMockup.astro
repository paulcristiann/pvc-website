---
// Stylized, data-free mockup of the enrollment flow ending in a signed document.
const steps = ['Choose course', 'Scan ID', 'Sign forms', 'Enrolled'];
---

<div class="enr" aria-hidden="true">
  <ol class="enr-steps">
    {
      steps.map((s, i) => (
        <li style={`--i:${i}`}>
          <span class="enr-dot">{i === steps.length - 1 ? '✓' : i + 1}</span>
          <span class="enr-label">{s}</span>
        </li>
      ))
    }
  </ol>
  <div class="enr-doc">
    <div class="enr-doc-head">
      <span class="enr-pdf">PDF</span>
      <span class="enr-lines"><i></i><i></i></span>
    </div>
    <div class="enr-doc-body">
      <i></i><i></i><i></i><i></i>
    </div>
    <svg class="enr-sig" viewBox="0 0 160 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <path d="M6 28c10-14 18-20 22-14s-6 18 2 16 14-22 20-18-4 16 4 14 10-12 16-10 0 10 8 8 12-8 18-6"></path>
    </svg>
    <span class="enr-signed">Signed</span>
  </div>
</div>

<style>
  .enr {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    align-items: center;
  }
  .enr-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
  }
  .enr-steps::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: var(--surface-3);
  }
  .enr-steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 90ms);
  }
  .enr-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--surface);
    border: 1.5px solid var(--accent);
    color: var(--accent);
  }
  .enr-steps li:last-child .enr-dot {
    background: var(--signal);
    border-color: var(--signal);
    color: #fff;
  }
  .enr-doc {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    box-shadow: var(--shadow-sm);
    transform: rotate(2deg);
    transition: transform 0.6s var(--ease);
  }
  :global(.case-card:hover) .enr-doc {
    transform: rotate(0deg) translateY(-2px);
  }
  .enr-doc-head {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 12px;
  }
  .enr-pdf {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    color: #fff;
    background: #e5484d;
    padding: 3px 5px;
    border-radius: 4px;
  }
  .enr-lines,
  .enr-doc-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .enr-doc i {
    display: block;
    height: 5px;
    border-radius: 3px;
    background: var(--surface-3);
  }
  .enr-lines i:last-child,
  .enr-doc-body i:nth-child(3) {
    width: 60%;
  }
  .enr-sig {
    color: var(--accent);
    width: 70%;
    margin-top: 10px;
    stroke-dasharray: 260;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s var(--ease) 0.4s;
  }
  .enr-signed {
    position: absolute;
    right: 12px;
    bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--signal);
    border: 1px solid currentColor;
    padding: 2px 6px;
    border-radius: 5px;
  }
  :global(.reveal:not(.is-visible)) .enr-steps li {
    opacity: 0;
    transform: translateX(-8px);
  }
  :global(.reveal:not(.is-visible)) .enr-sig {
    stroke-dashoffset: 260;
  }
  @media (prefers-reduced-motion: reduce) {
    .enr-sig,
    .enr-steps li,
    .enr-doc {
      transition: none;
    }
  }
</style>
