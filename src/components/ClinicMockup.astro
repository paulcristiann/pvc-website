---
// Stylized, data-free mockup of the clinic dashboard: a day view split by
// doctor, an online booking dropping into a free slot, and the patient's
// record updated in the same step.
const nav = ['cal', 'rec', 'inv', 'rep'];
const times = ['09:00', '10:00', '11:00', '12:00'];
// [doctor column, start row, span, isNew]
const appts: [number, number, number, boolean][] = [
  [0, 1, 1, false],
  [0, 3, 2, false],
  [1, 1, 2, false],
  [1, 4, 1, false],
  [2, 2, 1, true],
  [2, 3, 1, false],
];
---

<div class="cl" aria-hidden="true">
  <div class="cl-bar">
    <span></span><span></span><span></span>
  </div>
  <div class="cl-body">
    <nav class="cl-nav">
      {nav.map((n, i) => <span class:list={['cl-nav-i', n, { on: i === 0 }]} />)}
    </nav>
    <div class="cl-main">
      <div class="cl-head">
        <span class="cl-title">Today</span>
        <span class="cl-docs">
          <i class="d0"></i><i class="d1"></i><i class="d2"></i>
        </span>
      </div>
      <div class="cl-grid">
        <div class="cl-times mono">
          {times.map((t) => <span>{t}</span>)}
        </div>
        <div class="cl-cols">
          {[0, 1, 2].map((c) => <div class="cl-col" style={`grid-column:${c + 1}`} />)}
          {
            appts.map(([c, r, span, isNew]) => (
              <div
                class:list={['cl-appt', `d${c}`, { new: isNew }]}
                style={`grid-column:${c + 1};grid-row:${r}/span ${span}`}
              >
                {isNew ? <b>Vaccine</b> : <i />}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="cl-toast">
    <svg class="cl-paw" viewBox="0 0 24 24" fill="currentColor">
      <ellipse cx="6" cy="10" rx="2.2" ry="2.8"></ellipse>
      <ellipse cx="10" cy="5.5" rx="2.2" ry="2.8"></ellipse>
      <ellipse cx="14" cy="5.5" rx="2.2" ry="2.8"></ellipse>
      <ellipse cx="18" cy="10" rx="2.2" ry="2.8"></ellipse>
      <path d="M12 11c-3 0-6 4.5-6 7 0 1.7 1.3 2.5 3 2.5 1.2 0 2-.6 3-.6s1.8.6 3 .6c1.7 0 3-.8 3-2.5 0-2.5-3-7-6-7z"></path>
    </svg>
    <span class="cl-toast-text">
      <b>New online booking</b>
      <span>Vaccine · 10:00 · record updated</span>
    </span>
  </div>
</div>

<style>
  .cl {
    --d0: #0a84ff;
    --d1: #30b06e;
    --d2: #bf5af2;
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    overflow: visible;
  }
  .cl-bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
  }
  .cl-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--surface-3);
  }
  .cl-body {
    display: grid;
    grid-template-columns: 34px 1fr;
  }

  /* Sidebar: calendar, records, invoices, reports */
  .cl-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-right: 1px solid var(--border);
  }
  .cl-nav-i {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .cl-nav-i.on {
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    border-color: var(--accent);
  }

  .cl-main {
    padding: 9px 12px 12px;
  }
  .cl-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .cl-title {
    font-size: 0.72rem;
    font-weight: 650;
  }
  .cl-docs {
    display: flex;
  }
  .cl-docs i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--surface);
    margin-left: -4px;
    background: var(--d);
  }
  .d0 {
    --d: var(--d0);
  }
  .d1 {
    --d: var(--d1);
  }
  .d2 {
    --d: var(--d2);
  }

  /* Day view, one column per doctor */
  .cl-grid {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 6px;
  }
  .cl-times {
    display: grid;
    grid-template-rows: repeat(4, 22px);
    gap: 4px;
    font-size: 0.54rem;
    color: var(--text-tertiary);
  }
  .cl-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 22px);
    gap: 4px 5px;
  }
  .cl-col {
    grid-row: 1 / -1;
    border-radius: 6px;
    background: repeating-linear-gradient(to bottom, var(--surface-2) 0 22px, transparent 22px 26px);
  }
  .cl-appt {
    display: flex;
    align-items: center;
    padding: 0 6px;
    border-radius: 5px;
    border-left: 3px solid var(--d);
    background: color-mix(in srgb, var(--d) 15%, var(--surface));
    font-size: 0.58rem;
    overflow: hidden;
  }
  .cl-appt i {
    display: block;
    width: 70%;
    height: 4px;
    border-radius: 2px;
    background: var(--d);
    opacity: 0.45;
  }
  .cl-appt b {
    font-weight: 600;
    white-space: nowrap;
  }
  .cl-appt.new {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--d) 35%, transparent);
    transition: opacity 0.4s ease 0.6s, transform 0.5s var(--ease) 0.6s;
  }

  /* Notification */
  .cl-toast {
    position: absolute;
    right: -12px;
    bottom: -16px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 11px 7px 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-md);
    transition: opacity 0.4s ease 0.2s, transform 0.5s var(--ease) 0.2s;
  }
  .cl-paw {
    width: 18px;
    height: 18px;
    padding: 3px;
    border-radius: 6px;
    color: #fff;
    background: var(--d2);
    flex-shrink: 0;
  }
  .cl-toast-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .cl-toast-text b {
    font-size: 0.62rem;
    font-weight: 600;
  }
  .cl-toast-text span {
    font-size: 0.56rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  /* Initial state, before the card scrolls into view */
  :global(.reveal:not(.is-visible)) .cl-toast {
    opacity: 0;
    transform: translateY(8px);
  }
  :global(.reveal:not(.is-visible)) .cl-appt.new {
    opacity: 0;
    transform: scale(0.9);
  }
  @media (prefers-reduced-motion: reduce) {
    .cl * {
      transition: none !important;
    }
  }
</style>
